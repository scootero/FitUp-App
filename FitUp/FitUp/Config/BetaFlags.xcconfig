// =============================================================================
// BUILD FLAGS
//
// FITUP_PAYWALL_LOGGING = NO  → Quiet StoreKit / paywall AppLogger lines.
// FITUP_PAYWALL_LOGGING = YES → Verbose paywall logs (use when testing purchases).
//
// Subscription access overrides exist only in #if DEBUG code paths.
// Release / TestFlight / App Store builds always follow real StoreKit entitlements.
// =============================================================================
FITUP_PAYWALL_LOGGING = NO
